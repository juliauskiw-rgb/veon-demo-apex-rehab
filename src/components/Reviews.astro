---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { reviews, links, SOON } from "../data/clinic";
---
<section id="reviews" class="rev section" data-rec="R-UX-12,S-R015,G-R007" aria-labelledby="rev-title">
  <div class="container">
    <div class="section-head rev__head">
      <h2 id="rev-title">Відгуки пацієнтів</h2>
      <p>Відгуки з Google Maps, як їх бачать пацієнти. Повні тексти й інші відгуки на картці центру.</p>
    </div>

    <figure class="quote">
      <blockquote class="quote__text"><p>«{reviews.main.text}»</p></blockquote>
      <figcaption class="quote__by"><span class="quote__name">{reviews.main.name}</span> <span class="small muted">відгук у Google</span></figcaption>
    </figure>

    <ul class="frags">
      {reviews.fragments.map((r) => (
        <li class="frag">
          <figure>
            <blockquote><p>«{r.text}»</p></blockquote>
            <figcaption><span class="frag__name">{r.name}</span> <span class="small muted">фрагмент відгуку в Google</span></figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <div class="rev__links">
      <a class="tlink rev__map" href={links.map} target="_blank" rel="noopener">Усі відгуки на Google Maps <Icon name="arrow" class="arrow" /></a>
      <FutureLink note={SOON} class="small">Сторінка відгуків</FutureLink>
    </div>
  </div>
</section>

<style>
  .rev { background: var(--color-surface); }
  .quote { margin: 0 0 var(--s-5); display: grid; gap: var(--s-3); max-width: 58rem; padding-left: var(--s-4); border-left: var(--cross) solid var(--color-accent); }
  .quote__text { margin: 0; }
  .quote__text p { font-family: var(--font-display); font-size: var(--fs-h2); line-height: 1.18; font-weight: var(--w-display); max-width: 30ch; }
  .quote__by { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--s-2); }
  .quote__name { font-weight: 600; font-size: var(--fs-lead); }

  .frags { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--gap); }
  .frag figure { margin: 0; display: grid; gap: var(--s-2); height: 100%; align-content: space-between; padding-top: var(--s-3); border-top: 1px solid var(--color-line); }
  .frag blockquote { margin: 0; }
  .frag figcaption { display: grid; gap: 0.15rem; }
  .frag__name { font-weight: 600; }

  .rev__links { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2) var(--s-4); margin-top: var(--s-4); }
  .rev__map { color: var(--color-accent); }

  @media (max-width: 63.99rem) {
    .frags { grid-template-columns: minmax(0, 1fr); gap: var(--s-3); }
  }
  @media (max-width: 47.99rem) {
    .quote { padding-left: var(--s-3); margin-bottom: var(--s-4); }
    .quote__text p { font-size: var(--fs-h3); line-height: 1.25; }
    .frags { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: calc(-1 * var(--gutter)); padding: 0 var(--gutter) var(--s-2); scroll-padding-inline: var(--gutter); gap: var(--s-2); overscroll-behavior-x: contain; scrollbar-width: thin; }
    .frag { flex: 0 0 80%; scroll-snap-align: start; }
  }
</style>
