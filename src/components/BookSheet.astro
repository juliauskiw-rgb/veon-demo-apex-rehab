---
// "Записатися" → choose a real channel. No form, no fake submit (demo.md §6, ux §7).
import Icon from "./Icon.astro";
import { links, PHONE_DISPLAY } from "../data/clinic";
---
<dialog class="sheet" id="book-sheet" aria-labelledby="sheet-title" data-sheet data-rec="R-UX-02,G-R001">
  <div class="sheet__head">
    <p class="sheet__title" id="sheet-title">Як вам зручніше записатися?</p>
    <button class="sheet__close" type="button" aria-label="Закрити" data-sheet-close><Icon name="close" /></button>
  </div>
  <ul class="sheet__list">
    <li data-channel="call"><a class="sheet__item sheet__item--call" href={links.tel}><Icon name="phone" /><span><b>Подзвонити</b><span class="num">{PHONE_DISPLAY}</span></span></a></li>
    <li><a class="sheet__item" href={links.telegram} target="_blank" rel="noopener"><Icon name="telegram" /><span><b>Telegram</b><span>@ApexRrhab</span></span></a></li>
    <li><a class="sheet__item" href={links.viber}><Icon name="viber" /><span><b>Viber</b><span class="num">{PHONE_DISPLAY}</span></span></a></li>
    <li><a class="sheet__item" href={links.whatsapp} target="_blank" rel="noopener"><Icon name="whatsapp" /><span><b>WhatsApp</b><span class="num">{PHONE_DISPLAY}</span></span></a></li>
  </ul>
  <p class="small muted sheet__note">Пн–пт 8:00–20:00, сб–нд 10:00–20:00</p>
</dialog>

<style>
  .sheet { width: min(100% - 2 * var(--gutter), 28rem); padding: 0; border: 0; border-top: var(--cross) solid var(--color-accent); border-radius: var(--radius); background: var(--color-bg); color: var(--color-text); }
  .sheet::backdrop { background: var(--color-scrim); }
  .sheet[open] { animation: sheet-in var(--dur-tab) var(--ease-out); }
  .sheet__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); padding: var(--s-3) var(--s-3) var(--s-2); }
  .sheet__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: var(--w-display-strong); line-height: 1.2; }
  .sheet__close { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border: 0; border-radius: var(--radius); background: var(--color-surface); color: var(--color-text); cursor: pointer; transition: background-color var(--dur-fast) var(--ease-out); }
  .sheet__close:hover { background: var(--color-line); }
  .sheet__list { display: grid; gap: var(--s-1); padding: 0 var(--s-3); }
  .sheet__item { display: flex; align-items: center; gap: var(--s-2); min-height: 64px; padding: var(--s-1) var(--s-2); border: 1px solid var(--color-line); border-radius: var(--radius); text-decoration: none; transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .sheet__item > span { display: grid; line-height: 1.3; }
  .sheet__item b { font-weight: 600; }
  .sheet__item span span { font-size: var(--fs-small); color: var(--color-muted); }
  .sheet__item :global(.icon) { flex: none; color: var(--color-accent); }
  .sheet__item:hover { background: var(--color-surface); }
  .sheet__item:active { transform: scale(0.98); }
  .sheet__item--call { background: var(--color-accent); color: var(--color-on-accent); border-color: var(--color-accent); }
  .sheet__item--call :global(.icon), .sheet__item--call span span { color: var(--color-on-accent); }
  .sheet__item--call:hover { background: var(--color-accent-strong); }
  .sheet__item--call:focus-visible { outline-offset: 3px; }
  .sheet__note { padding: var(--s-2) var(--s-3) var(--s-3); }
  .sheet.is-write [data-channel="call"] { display: none; }
  @media (max-width: 47.99rem) {
    .sheet { width: 100%; max-width: 100%; margin: auto 0 0; border-radius: var(--radius) var(--radius) 0 0; }
    .sheet[open] { animation-name: sheet-up; }
  }
  @keyframes sheet-in { from { opacity: 0; transform: translateY(8px); } }
  @keyframes sheet-up { from { transform: translateY(40%); opacity: 0.001; } }
  @media (prefers-reduced-motion: reduce) {
    .sheet[open] { animation: none; }
    .sheet__item:active { transform: none; }
  }
</style>
