---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { priceGroups, SOON } from "../data/clinic";

const courseRows = priceGroups.find((g) => g.id === "courses")?.rows ?? [];
const courseNums = courseRows.map((r) => Number(r.price.replace(/\s/g, "")));
const fmt = (n: number) => n.toLocaleString("uk-UA").replace(/ | /g, " ");
const courseMin = fmt(Math.min(...courseNums));
const courseMax = fmt(Math.max(...courseNums));
---
<section id="prices" class="prices section" data-rec="R-UX-08,G-R005" aria-labelledby="prices-title">
  <div class="container prices__grid">
    <div class="prices__main">
      <div class="section-head">
        <h2 id="prices-title">Ціни на консультації та курси</h2>
      </div>

      <div class="tabs" id="price-tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="Групи цін">
          {priceGroups.map((g, i) => (
            <button class="tabs__tab" type="button" role="tab" id={`tab-${g.id}`} aria-controls={`panel-${g.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{g.tab}</button>
          ))}
        </div>
        <div class="tabs__panels">
          {priceGroups.map((g) => (
            <div class="tabs__panel" role="tabpanel" id={`panel-${g.id}`} aria-labelledby={`tab-${g.id}`} tabindex="0">
              <h3 class="tabs__panel-title">{g.title}</h3>
              <ul class="rows">
                {g.rows.map((r) => (
                  <li class="row">
                    <div class="row__name">
                      <span class="row__title">{r.name}</span>
                      <span class="row__note small muted">{r.note}</span>
                    </div>
                    <span class="row__bar cross-bar" aria-hidden="true"></span>
                    <p class="row__price num">{r.price}<span class="row__cur"> грн</span></p>
                  </li>
                ))}
              </ul>
              {g.id === "consult" && (
                <a class="tlink prices__courses" href="#prices" data-tab="tab-courses">
                  <span>Курси після травм і операцій</span>
                  <span class="num prices__courses-sum">{courseMin}–{courseMax} грн</span>
                  <Icon name="arrow" class="arrow" />
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    <aside class="prices__aside" aria-label="Перший крок">
      <div class="first">
        <p class="first__label">Перший крок: консультація фізичного терапевта</p>
        <p class="first__price num"><span class="first__from">від</span> 500 <span class="first__cur">грн</span></p>
        <p class="small muted">Діагностика стану і план реабілітації на першій зустрічі.</p>
        <a class="btn first__btn" href="#contacts" data-book data-rec="R-UX-02">Записатися <Icon name="arrow" class="arrow" /></a>
      </div>
      <p class="prices__full"><FutureLink note={SOON}>Повний прайс: масаж, мануальна терапія, фізіотерапія</FutureLink></p>
    </aside>
  </div>
</section>

<style>
  .prices__grid { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: var(--gap); align-items: start; }
  .prices__main { padding-right: var(--s-5); }

  .tabs__list { display: none; }
  .tabs__panel { padding-block: var(--s-2) var(--s-4); }
  .tabs__panel-title { margin-bottom: var(--s-2); }
  .tabs__panel:focus-visible { outline-offset: 4px; }

  /* with scripting: a tab switch; the panel area keeps a min height so the page does not jump */
  :global(.is-tabbed) .tabs__list { display: flex; gap: var(--s-1); border-bottom: 1px solid var(--color-line); margin-bottom: var(--s-2); }
  :global(.is-tabbed) .tabs__panels { min-height: 19rem; }
  :global(.is-tabbed) .tabs__panel-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  :global(.is-tabbed) .tabs__panel:not([hidden]) { animation: tab-in var(--dur-tab) var(--ease-out); }
  .tabs__tab { position: relative; min-height: 52px; padding: 0 var(--s-3); border: 0; background: transparent; color: var(--color-muted); font: 600 var(--fs-body) / 1.2 var(--font-body); cursor: pointer; border-radius: var(--radius) var(--radius) 0 0; transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out); }
  .tabs__tab::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--color-accent); transform: scaleX(0); transition: transform var(--dur-fast) var(--ease-out); }
  .tabs__tab:hover { color: var(--color-text); background: var(--color-surface); }
  .tabs__tab[aria-selected="true"] { color: var(--color-text); }
  .tabs__tab[aria-selected="true"]::after { transform: scaleX(1); }
  .tabs__tab:focus-visible { outline-offset: -2px; }

  .prices__courses { display: none; }
  :global(.is-tabbed) .prices__courses { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--s-1) var(--s-3); margin-top: var(--s-3); padding: var(--s-3) 0 0; font-weight: 600; font-size: var(--fs-lead); color: var(--color-accent); }
  .prices__courses-sum { font-family: var(--font-display); font-size: var(--fs-price-row); color: var(--color-text); }
  .rows { display: grid; }
  .row { display: grid; grid-template-columns: minmax(0, 1fr) var(--cross) 9.5rem; align-items: stretch; column-gap: var(--s-3); border-bottom: 1px solid var(--color-line); }
  .row__name { display: grid; gap: 0.2rem; align-content: center; padding-block: var(--s-3); }
  .row__title { font-weight: 600; font-size: var(--fs-lead); line-height: 1.3; }
  .row__price { align-self: center; justify-self: end; font-family: var(--font-display); font-size: var(--fs-price-row); line-height: 1; font-weight: var(--w-display); white-space: nowrap; }
  .row__cur { font-size: 0.5em; font-family: var(--font-body); font-weight: 500; color: var(--color-muted); }

  .prices__aside { position: sticky; top: calc(var(--header-h) + var(--s-4)); display: grid; gap: var(--s-3); }
  .first { display: grid; gap: var(--s-2); padding: var(--s-4); background: var(--color-surface); border-top: var(--cross) solid var(--color-accent); }
  .first__label { font-weight: 600; }
  .first__price { font-family: var(--font-display); font-size: var(--fs-price); line-height: 1; font-weight: var(--w-display); color: var(--color-accent); }
  .first__from, .first__cur { font-size: 0.42em; font-weight: 500; color: var(--color-text); }
  .first__btn { margin-top: var(--s-1); justify-self: start; }
  .prices__full { font-weight: 500; }

  @keyframes tab-in { from { opacity: 0; transform: translateY(8px); } }

  @media (max-width: 63.99rem) {
    .prices__grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-4); }
    .prices__main { padding-right: 0; }
    .prices__aside { position: static; }
  }
  @media (max-width: 47.99rem) {
    :global(.is-tabbed) .tabs__list { margin-inline: calc(-1 * var(--gutter)); padding-inline: var(--gutter); gap: 0; }
    .tabs__tab { flex: 1 1 0; padding: 0 var(--s-1); font-size: var(--fs-small); }
    :global(.is-tabbed) .tabs__panels { min-height: 0; }
    .row { grid-template-columns: minmax(0, 1fr) var(--cross) 8.25rem; column-gap: var(--s-2); }
    .row__title { font-size: var(--fs-body); }
    .first { grid-template-columns: auto 1fr; align-items: center; column-gap: var(--s-3); padding: var(--s-3); }
    .first__label, .first > .small { display: none; }
    .first__btn { margin-top: 0; justify-self: end; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.is-tabbed) .tabs__panel:not([hidden]) { animation: none; }
    .tabs__tab::after { transition: none; }
  }
</style>
