---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { conditions, alsoTreat, SOON } from "../data/clinic";
---
<section id="conditions" class="cond section" data-rec="R-UX-07" aria-labelledby="cond-title">
  <div class="container">
    <div class="section-head">
      <h2 id="cond-title">Що ми лікуємо</h2>
      <p>Знайдіть свій діагноз. Якщо його немає в списку, зателефонуйте: підкажемо, чи зможемо допомогти.</p>
    </div>

    <div class="shield" data-draw>
      <span class="shield__v cross-bar" aria-hidden="true"></span>
      <span class="shield__h cross-bar" aria-hidden="true"></span>
      {conditions.map((c, i) => (
        <article class:list={["field", `field--${i + 1}`]} id={c.id} aria-labelledby={`${c.id}-t`}>
          <h3 class="field__title" id={`${c.id}-t`}>
            <button class="field__toggle" type="button" aria-expanded="true" aria-controls={`${c.id}-p`} data-acc disabled>
              <span>{c.title}</span>
              <Icon name="chevron" class="field__chev" />
            </button>
          </h3>
          <div class="field__panel" id={`${c.id}-p`}>
            <ul class="field__list">
              {c.items.map((d) => <li><FutureLink note={SOON}>{d}</FutureLink></li>)}
            </ul>
            <p class="field__methods small"><span class="muted">Методи:</span> {c.methods}</p>
            {c.courses && (
              <a class="tlink field__courses" href="#prices" data-tab="tab-courses">Курси реабілітації та ціни <Icon name="arrow" class="arrow" /></a>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="cond__also">
      <p class="cond__also-lead">Також працюємо з такими станами</p>
      <p class="cond__also-list">{alsoTreat.map((a, i) => <><FutureLink note={SOON}>{a}</FutureLink>{i < alsoTreat.length - 1 ? ", " : "."}</>)}</p>
    </div>
  </div>
</section>

<style>
  /* the shield: 2×2 fields, the crimson cross instead of the gutters */
  .shield { display: grid; grid-template-columns: minmax(0, 1fr) var(--cross) minmax(0, 1fr); grid-template-rows: auto var(--cross) auto; }
  .shield__v { grid-column: 2; grid-row: 1 / 4; transform-origin: center top; }
  .shield__h { grid-column: 1 / 4; grid-row: 2; transform-origin: center; }
  .field { padding: var(--s-5) var(--s-4); background: var(--color-bg); }
  .field--1 { grid-column: 1; grid-row: 1; background: var(--color-surface); }
  .field--2 { grid-column: 3; grid-row: 1; }
  .field--3 { grid-column: 1; grid-row: 3; }
  .field--4 { grid-column: 3; grid-row: 3; background: var(--color-surface); }
  .field--1, .field--3 { padding-left: 0; padding-inline-start: var(--s-4); }

  .field__title { font-size: var(--fs-h3); }
  .field__toggle { all: unset; display: flex; align-items: baseline; gap: var(--s-2); width: 100%; min-height: 48px; color: var(--color-text); cursor: default; font: inherit; }
  .field__count { font-family: var(--font-body); font-size: var(--fs-small); font-weight: 500; color: var(--color-muted); }
  .field__toggle :global(.field__chev) { display: none; }
  .field__panel { display: grid; gap: var(--s-3); margin-top: var(--s-3); }
  .field__panel[hidden] { display: none; }
  .field__list { columns: 2; column-gap: var(--s-3); }
  .field__list li { break-inside: avoid; padding-block: 0.3rem; }
  .field__list :global(.future-link) { min-height: 32px; transition: color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .field__list :global(.future-link:hover) { color: var(--color-accent); transform: translateX(4px); }
  .field__methods { max-width: 52ch; padding-top: var(--s-2); border-top: 1px solid var(--color-line); }
  .field__courses { color: var(--color-accent); justify-self: start; }
  .cond__also { display: grid; grid-template-columns: minmax(0, 1fr) var(--cross) minmax(0, 1fr); align-items: center; margin-top: var(--cross); background: var(--color-surface); border-bottom: var(--cross) solid var(--color-accent); max-width: none; font-size: var(--fs-body); padding: var(--s-3) var(--s-4); }
  .cond__also-lead { grid-column: 1; font-family: var(--font-display); font-size: var(--fs-h3); line-height: 1.2; padding-right: var(--s-4); }
  .cond__also::before { content: ""; grid-column: 2; grid-row: 1; align-self: stretch; background: var(--color-accent); }
  .cond__also-list { grid-column: 3; padding-left: var(--s-4); }

  /* the cross assembles once the shield enters the screen */
  :global(.js) .shield[data-draw]:not(.is-drawn) .shield__v { transform: scaleY(0); }
  :global(.js) .shield[data-draw]:not(.is-drawn) .shield__h { transform: scaleX(0); }
  .shield__v, .shield__h { transition: transform var(--dur-cross) var(--ease-out); }
  .shield__h { transition-delay: 120ms; }

  @media (max-width: 63.99rem) {
    .field { padding: var(--s-4) var(--s-3); }
    .field--1, .field--3 { padding-inline-start: var(--s-3); }
    .field__list { columns: 1; }
    .cond__also { padding: var(--s-3); }
  }

  /* phone: accordion of four fields separated by the cross bars, the first one open */
  @media (max-width: 47.99rem) {
    .shield { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; gap: var(--cross); background: var(--color-accent); margin-inline: calc(-1 * var(--gutter)); border-block: var(--cross) solid var(--color-accent); }
    .shield__v, .shield__h { display: none; }
    .field, .field--1, .field--2, .field--3, .field--4 { grid-column: 1; grid-row: auto; padding: 0 var(--gutter); }
    .field__toggle { cursor: pointer; min-height: 64px; align-items: center; }
    .field__toggle:focus-visible { outline: 2px solid var(--color-accent); outline-offset: -4px; }
    .field__toggle :global(.field__chev) { display: block; margin-inline-start: auto; color: var(--color-accent); transition: transform var(--dur-fast) var(--ease-out); }
    .field__toggle[aria-expanded="true"] :global(.field__chev) { transform: rotate(180deg); }
    .field__panel { margin-top: 0; padding-bottom: var(--s-3); }
    .field__list { columns: 2; column-gap: var(--s-2); font-size: var(--fs-small); }
    .field__list :global(.future-link:hover) { transform: none; }
    :global(.js) .shield[data-draw]:not(.is-drawn) .shield__v, :global(.js) .shield[data-draw]:not(.is-drawn) .shield__h { transform: none; }
  }
  @media (max-width: 47.99rem) {
    .cond__also { grid-template-columns: minmax(0, 1fr); gap: var(--s-1); margin-inline: calc(-1 * var(--gutter)); padding: var(--s-3) var(--gutter); }
    .cond__also::before { display: none; }
    .cond__also-lead, .cond__also-list { grid-column: 1; padding: 0; }
    .cond__also-lead { font-size: var(--fs-lead); }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .shield[data-draw]:not(.is-drawn) .shield__v, :global(.js) .shield[data-draw]:not(.is-drawn) .shield__h { transform: none; }
    .field__list :global(.future-link:hover) { transform: none; }
  }
</style>
